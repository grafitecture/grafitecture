{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:8080/",
        "http://127.0.0.1:8080/en",
        "http://127.0.0.1:8080/impressum"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "aggregationMethod": "median-run",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 1048576
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 102400
          }
        ],
        "resource-summary:third-party:count": [
          "error",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "seo/lighthouse"
    }
  }
}
